{
  "name": "ksp-cli",
  "version": "1.0.0",
  "description": "CLI for searching and inspecting products sold by KSP Israel",
  "type": "module",
  "bin": {
    "ksp-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "test": "npm run build && node --test tests/*.test.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "cycletls": "^2.0.5",
    "turndown": "^7.2.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.7.0"
  }
}
